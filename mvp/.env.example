# Copy to .env. Never commit real keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Explicit offline walkthrough only; never presented as Gemini output.
LLM_MODE=gemini
# Shared Google project/model quota bucket. Every process using the same
# DATABASE_PATH and Google project must use the same value.
LLM_QUOTA_BUCKET=codelit-google-project
# Local caps observed for this project. External callers using the same Google
# project are not visible to this database, so lower these for safety headroom.
LLM_RPM=5
LLM_INPUT_TPM=250000
LLM_RPD=20
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
# Maximum real Gemini calls per task stage, including retries.
LLM_RETRY_LIMIT=3
# Durable queue bounds; HTTP requests return immediately instead of waiting.
LLM_QUEUE_MAX=20
LLM_QUEUE_TIMEOUT_SECONDS=120
PORT=8000
HOST=127.0.0.1
# Remote GCP judge gateway. Railway does not need Docker access.
GCP_JUDGE_URL=
GCP_JUDGE_TOKEN=
GCP_JUDGE_TIMEOUT=65
# OAuth Web client, separate from the Gemini API key. Register the exact URI.
# Only verified Google Workspace accounts @hcmut.edu.vn are accepted.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
# HTTPS callback enables Secure cookies automatically; 0 for localhost HTTP.
COOKIE_SECURE=0
# Required for XML import/export of solutions and the MCQ bank.
ADMIN_TOKEN=
